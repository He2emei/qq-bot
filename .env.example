# 环境变量配置示例
# 复制此文件为 .env 并填入您的实际值

# AI 早报来源（不配置微信私有接口时会自动使用 B 站发现）
AI_DAILY_SOURCE_ORDER=wechat_private,bilibili
BILIBILI_UPLOADER_MID=285286947
BILIBILI_UPLOADER_NAME=橘鸦Juya
BILIBILI_SEARCH_KEYWORD=橘鸦Juya
WECHAT_ACCOUNT_NICKNAME=橘鸦Juya

# 可选：用于微信文章列表发现和页面直连失败时的 Markdown 回退
WECHAT_API_BASE_URL=https://wxcrawl.touchturing.com
WECHAT_API_KEY=
WECHAT_API_SECRET=

# Tibo Radar（不配置 key 时不会启动，也不会发送消息）
TIBO_RADAR_API_KEY=
TIBO_RADAR_API_BASE_URL=https://api.twitterapi.io
TIBO_RADAR_HANDLE=thsottiaux
TIBO_RADAR_GROUP_ID=1105591264
TIBO_RADAR_POLL_INTERVAL_SECONDS=900
TIBO_RADAR_STATE_PATH=data/tibo_radar_state.json
TIBO_RADAR_BOOTSTRAP_SEND=false
TIBO_RADAR_STREAM_ENABLED=true
TIBO_RADAR_WEBSOCKET_URL=wss://ws.twitterapi.io/twitter/tweet/websocket
TIBO_RADAR_RULE_TAG=qq-bot-tibo-radar
TIBO_RADAR_RULE_INTERVAL_SECONDS=5

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.lkeap.cloud.tencent.com/v1

# Notion API 配置
NOTION_TOKEN=your_notion_token_here
NOTION_TOKEN_DIARY=your_notion_diary_token_here

# NapCat WebSocket 配置
NAPCAT_BASE_URL=http://127.0.0.1:23334
NAPCAT_WS_URL=ws://127.0.0.1:23334
NAPCAT_ACCESS_TOKEN=your_napcat_access_token_here
STATUS_AUTHORIZED_USER_ID=
STATUS_ALLOWED_SOURCE_IPS=127.0.0.1,::1
